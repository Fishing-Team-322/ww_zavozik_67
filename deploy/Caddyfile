suck-and-see.net {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    # Temporary entry-point redirect while Cloudflare asset transfers are cut
    # short on affected networks. Keep API/revision probes at the canonical URL.
    @application not path /v1/* /build-info.json /_next/* /favicon.ico /robots.txt /sitemap.xml
    redir @application https://puls-85-159-231-68.sslip.io{uri} 302
    reverse_proxy puls-production-web:3000
}

# Direct HTTPS fallback for networks that cannot download Cloudflare assets.
# Only this exact frontend Origin is mapped to the canonical application origin.
puls-85-159-231-68.sslip.io {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    @fallbackOrigin header Origin https://puls-85-159-231-68.sslip.io
    handle @fallbackOrigin {
        reverse_proxy puls-production-web:3000 {
            header_up Origin https://suck-and-see.net
        }
    }
    handle {
        reverse_proxy puls-production-web:3000
    }
}
