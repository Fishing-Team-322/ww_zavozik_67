# Copy to .env for Compose. The Go binaries read environment variables directly.
# Generate a fresh random secret, minimum 32 bytes; do not commit real credentials.
JWT_SECRET=
# Exact CIDRs of reverse proxies you operate. Empty: ignore forwarding headers.
# For production, route /v1/* directly through Caddy and trust only its Docker subnet.
TRUSTED_PROXY_CIDRS=
POSTGRES_PASSWORD=
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
# false is accepted only when both public URLs point to loopback.
COOKIE_SECURE=false

# Optional. Without a complete ID/secret pair the provider is not advertised.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Optional password reset delivery, STARTTLS required for remote servers.
SMTP_ADDR=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Native development only, for a local SMTP capture server:
SMTP_LOCAL_PLAINTEXT=false

# Base64 of 32 random bytes; identical on API and worker. Back up with the DB.
DATA_ENCRYPTION_KEY=
# Exact OData hosts including nondefault port, comma separated; no scheme/path.
# Example: accounting.example.ru,127.0.0.1:8092
SOURCE_ALLOWED_HOSTS=
# Organization lookup provider (DaData, not a direct FNS connection).
DADATA_API_TOKEN=
# Operator-managed Hub: global FNS snapshot is shared read-only, filtered per tenant INN.
# Internal service URL only; users never supply this address or service token.
FNS_HUB_URL=
FNS_HUB_TOKEN=
FNS_HUB_COMPANY=
# Explicit synthetic supplier responses for local tests only. Forbidden with remote public URLs.
INTEGRATION_SANDBOX=false
# rules baseline; hybrid additionally calls the ML classifier.
CATEGORIZER_MODE=rules
# Native development path from backend/; Docker packages its own reports.
# MODEL_REPORTS_DIR=../ml/reports/metrics

# Optional existing synchronous training provider; forecasting gRPC cannot train.
# POST {"model":"auto"}; HTTP 200 {"trained":true,"model_version":"..."}.
TRAINING_URL=
TRAINING_TOKEN=
